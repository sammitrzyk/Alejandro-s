---
/* Ported from ui_kits/website/LandscapeInstallation.jsx. Deliberately not the ServicePage
   skeleton — this buyer is picturing a finished yard, not assessing construction competence. */
import Base from "../../../layouts/Base.astro";
import Container from "../../../components/Container.astro";
import Section from "../../../components/Section.astro";
import Reveal from "../../../components/Reveal.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import SectionHead from "../../../components/SectionHead.astro";
import ProjectTile from "../../../components/ProjectTile.astro";
import QuestionList from "../../../components/QuestionList.astro";
import EstimateBand from "../../../components/EstimateBand.astro";

const P = "/photos/";
const PHONE = "(717) 736-6538";
const phoneHref = `tel:${PHONE.replace(/\D/g, "")}`;

const LOOK_FACTORS: [string, string, string][] = [
  ["Bed lines", "The single biggest change, and the cheapest. A bed cut in a long shallow curve reads as designed. One that traces the foundation in a straight strip reads as an afterthought.", "wide"],
  ["Layering", "Tall at the back, mid in the middle, low at the front, and nothing planted in a single row. Depth is what separates a landscape from a hedge.", "tall"],
  ["Evergreen structure", "Something with green in February. A bed built entirely from things that die back looks finished in June and empty for five months.", "wide"],
  ["Mulch or stone", "Mulch is warmer and softer and needs redoing. Stone is permanent, reflects heat, and is unforgiving if you change your mind.", "std"],
  ["Room at the foundation", "Shrubs planted tight to the wall grow into the siding and block the windows within a decade. Space is planned for the mature size, not the pot size.", "std"],
  ["What is already there", "A mature specimen worth keeping changes the whole plan. Most renovations save more than the homeowner expects.", "wide"],
];
const INSTALL_ROWS: [string, string, string | null, string | null][] = [
  ["New planting beds", "Cut, shaped, edged and prepared before anything goes in the ground.", "stone-edge-bed.jpg", "Stone-edged planting bed"],
  ["Shrubs & ornamental trees", "Layered shrubs and ornamental plantings selected and set in prepared beds.", "commercial-property-beds.jpg", "Layered shrubs and ornamental plantings in a prepared bed"],
  ["Bed edging", "Set into the ground rather than laid on top of it.", "residential-lawn-beds.jpg", "Cut bed edge against lawn"],
  ["Renovating existing beds", "Taking out overgrown foundation shrubs often reveals grading nobody has looked at since the house was built.", null, null],
];
const SITE_FIT: [string, string][] = [
  ["How much sun does it actually get?", "Not at noon. At four in the afternoon in July, and whether the house shades it by six."],
  ["Where does the water go?", "A bed that stays wet kills anything that wants drainage, and no amount of amendment fixes a low spot."],
  ["How big does it get?", "The most common mistake on any property. What fits under the window now is above the roofline in fifteen years."],
  ["Who sees it, and from where?", "From the street, from the driveway, from the kitchen window. Not every side of a house earns the same investment."],
  ["How much upkeep do you want?", "Some plantings hold their shape on one cut a year. Others need four. Worth deciding before, not after."],
  ["How close to the foundation?", "Roots, moisture against the wall, and whether anyone can still get to the hose bib or the meter."],
];
const PROCESS: [string, string][] = [
  ["Walkthrough", "We stand in the yard and look at exposure, drainage and what is already growing well. The things worth keeping usually get decided here, and they change the plan more than anything else does."],
  ["Plan and price", "Bed shapes, plant list, sizes, edging, mulch or stone, and what is being removed first."],
  ["Install", "Removal, soil preparation, edging, planting, mulch. Beds get cut before anything is planted so the lines are set while there is still room to stand in them."],
  ["Establishment", "The first season is watering, and that part is yours. Everything installed is chosen to survive a normal Central PA winter, not a perfect one."],
];
---
<Base route="landscape-installation" headerOverlay headerActive="Landscaping">
  <Hero height="min(74vh,660px)" image={P + "stone-edge-bed.jpg"}
    alt="Stone-edged planting bed with layered shrubs against a house"
    eyebrow="Landscaping · Installation"
    title="A yard that finally feels finished."
    lede="Planting beds, shrubs, edging and renovation across the west shore, Harrisburg and the towns within twenty miles of New Cumberland."
    credit="Stone-edged beds and layered plantings">
    <Button slot="primary" variant="solidLight" size="lg" href="#estimate">Request an estimate</Button>
    <Button slot="secondary" variant="inverse" size="lg" href={phoneHref}><Icon name="phone" size={16} />{PHONE}</Button>
  </Hero>

  {/* See it */}
  <Section tone="light" tight>
    <Container>
      <Reveal><SectionHead eyebrow="Recent installations" title="See what changes the yard." /></Reveal>
      <div class="li-gallery" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--gap-grid);margin-top:var(--space-12);align-items:stretch">
        <Reveal><ProjectTile size="lg" ratio="4/3" image={P + "stone-edge-bed.jpg"} alt="Stone-edged bed with layered sculpted shrubs against a house" town="Central PA" service="Beds, edging & plantings" detail="Stone edge set into the ground, bed cut wide enough that the shrubs sit inside the line." /></Reveal>
        <div style="display:grid;grid-template-rows:auto auto;gap:var(--gap-grid);min-width:0">
          <Reveal delay={80}><ProjectTile ratio="4/3" image={P + "river-rock-landscape-v3.jpg"} alt="Curved driveway edged with a block retaining wall, barrel planters and black mulch running beside a decorative stone slope in grey and red rock, hedge line and mature trees behind" town="Central PA" service="River rock & decorative stone" /></Reveal>
          <Reveal delay={160}><ProjectTile ratio="4/3" image={P + "commercial-property-beds.jpg"} alt="Planting beds and layered shrubs along a building entrance" town="Central PA" service="Bed renovation & plantings" /></Reveal>
        </div>
      </div>
    </Container>
  </Section>

  {/* Cinematic read */}
  <section style="background:var(--surface-dark);color:var(--text-on-dark)">
    <div style="position:relative;overflow:hidden">
      <img src={P + "landscape-island-bed-fieldstone.jpg"} alt="Curved island bed edged in fieldstone with layered shrubs and grasses" loading="lazy" class="li-cinema-img" style="width:100%;aspect-ratio:4/3;object-fit:cover;object-position:50% 55%;display:block" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,36,22,0) 40%,rgba(10,36,22,.88) 100%)"></div>
      <Container style={{ position: "absolute", left: 0, right: 0, bottom: "var(--space-6)" }}>
        <Eyebrow tone="inverse" rule style={{ marginBottom: "var(--space-4)" }}>How a bed reads from the street</Eyebrow>
        <h2 class="li-cinema-h" style="font:var(--type-h2);letter-spacing:var(--ls-heading);color:#fff;max-width:14ch">What makes a yard look finished.</h2>
      </Container>
    </div>
    <Container style={{ padding: "var(--space-8) var(--gutter) var(--space-10)" }}>
      <div class="li-cinema-grid" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-6)">
        <Reveal>
          <p style="font:italic var(--fw-regular) clamp(1.375rem,2.2vw,1.875rem)/1.2 var(--font-display);color:var(--text-on-dark)">Shape before plants.</p>
          <p style="font:var(--type-small);color:var(--text-on-dark-secondary);margin-top:var(--space-3);max-width:34ch">A bed cut in one long curve does more than any shrub you put in it.</p>
        </Reveal>
        <Reveal delay={80} style={{ borderTop: "1px solid var(--border-dark)", padding: "var(--space-6) 0 0" }}>
          <p style="font:italic var(--fw-regular) clamp(1.375rem,2.2vw,1.875rem)/1.2 var(--font-display);color:var(--text-on-dark)">Height, then depth.</p>
          <p style="font:var(--type-small);color:var(--text-on-dark-secondary);margin-top:var(--space-3);max-width:34ch">Tall at the back, low at the front, nothing standing in a single row.</p>
        </Reveal>
        <Reveal delay={160} style={{ borderTop: "1px solid var(--border-dark)", padding: "var(--space-6) 0 0" }}>
          <p style="font:italic var(--fw-regular) clamp(1.375rem,2.2vw,1.875rem)/1.2 var(--font-display);color:var(--text-on-dark)">Green in February.</p>
          <p style="font:var(--type-small);color:var(--text-on-dark-secondary);margin-top:var(--space-3);max-width:34ch">Evergreen structure keeps the bed reading after everything else dies back.</p>
        </Reveal>
      </div>
    </Container>
  </section>

  {/* What changes the look */}
  <Section tone="light">
    <Container>
      <Reveal><SectionHead eyebrow="What changes the look" title="Decisions that matter more than the plant list." intro="Homeowners tend to start by choosing plants. Every one of these does more for the finished result than the species does." /></Reveal>
      <div class="li-factors" style="display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(20px,3vw,44px);margin-top:var(--space-16);align-items:start">
        {LOOK_FACTORS.map(([h, t, size], i) => (
          <Reveal delay={i * 60} class={size === "wide" ? "li-factor-offset" : ""}>
            <div style={`border-top:${size === "wide" ? "2px" : "1px"} solid ${size === "wide" ? "var(--gold-500)" : "var(--border-strong)"};padding-top:var(--space-5)`}>
              <h3 style={`font:${size === "wide" ? "var(--type-h3)" : "var(--type-h4)"};margin-bottom:var(--space-3)`}>{h}</h3>
              <p style={`font:var(--type-body);color:var(--text-secondary);max-width:${size === "wide" ? "52ch" : "34ch"};text-wrap:pretty`}>{t}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </Section>

  {/* Conversion moment */}
  <Section tone="dark" tight>
    <Container>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(28px,5vw,80px);align-items:center">
        <Reveal>
          <h2 style="font:var(--type-h2);letter-spacing:var(--ls-heading);color:var(--text-on-dark);max-width:16ch;text-wrap:pretty">Starting from scratch, or starting over?</h2>
          <p style="font:var(--type-lead);color:var(--text-on-dark-secondary);max-width:46ch;margin-top:var(--space-6);text-wrap:pretty">Send a photo of the front of the house. Most of what decides a planting plan is visible in one picture — which way it faces, what is already there, how much room there is to work with.</p>
        </Reveal>
        <Reveal delay={100} style={{ display: "flex", flexWrap: "wrap", gap: "var(--space-4)" }}>
          <Button variant="accent" size="lg" href="#estimate">Request a landscape estimate</Button>
          <Button variant="inverse" size="lg" href={phoneHref}><Icon name="phone" size={16} />{PHONE}</Button>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* What we install */}
  <Section tone="light">
    <Container>
      <Reveal><SectionHead eyebrow="What we install" title="The parts of a landscape." /></Reveal>
      <div style="margin-top:var(--space-6)">
        {INSTALL_ROWS.map(([h, t, img, alt], i) => (
          <Reveal delay={i * 60}>
            <div class={img ? "li-install-row" : ""} style={`display:grid;grid-template-columns:${img ? "112px minmax(0,1fr)" : "minmax(0,1fr)"};gap:var(--space-4);align-items:center;border-top:1px solid var(--border-hairline);padding:var(--space-4) 0`}>
              {img && <img src={P + img} alt={alt ?? ""} loading="lazy" class="li-install-img-mobile" style="width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--radius-image);display:block" />}
              <div>
                <h3 style="font:var(--type-h4);margin-bottom:var(--space-2);max-width:20ch">{h}</h3>
                <p style="font:var(--type-small);color:var(--text-secondary);max-width:46ch">{t}</p>
              </div>
              {img && <img src={P + img} alt={alt ?? ""} loading="lazy" class="li-install-img-wide" style="width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:var(--radius-image);display:none" />}
            </div>
          </Reveal>
        ))}
        <Reveal>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-8);border-top:1px solid var(--border-hairline);padding-top:var(--space-8)">
            <a href="/landscaping/mulch-beds/" style="font:var(--type-h4);color:var(--text-primary);text-decoration:none;border-bottom:1px solid var(--border-strong);padding-bottom:var(--space-4);display:block">Decorative rock →</a>
            <a href="/landscaping/mulch-beds/" style="font:var(--type-h4);color:var(--text-primary);text-decoration:none;border-bottom:1px solid var(--border-strong);padding-bottom:var(--space-4);display:block">Mulch →</a>
            <a href="/landscaping/landscape-lighting/" style="font:var(--type-h4);color:var(--text-primary);text-decoration:none;border-bottom:1px solid var(--border-strong);padding-bottom:var(--space-4);display:block">Landscape lighting →</a>
          </div>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Site fit */}
  <Section tone="dark">
    <Container>
      <Reveal><SectionHead tone="dark" eyebrow="Choosing what goes where" title="Six questions asked before a single plant is picked." intro="A plant that is wrong for the spot does not fail immediately. It fails in year four, which is long after anyone connects it back to the decision." /></Reveal>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0;margin-top:var(--space-12)">
        {SITE_FIT.map(([h, t], i) => (
          <Reveal delay={i * 60} style={{ borderTop: "1px solid var(--border-dark)", padding: "var(--space-8) var(--space-8) var(--space-8) 0" }}>
            <h3 style="font:var(--fw-semibold) 1.0625rem/1.35 var(--font-sans);color:var(--text-on-dark);margin-bottom:var(--space-3);max-width:26ch">{h}</h3>
            <p style="font:var(--type-small);color:var(--text-on-dark-secondary);max-width:34ch">{t}</p>
          </Reveal>
        ))}
      </div>
    </Container>
  </Section>

  {/* Process */}
  <Section tone="sunken">
    <Container width="var(--container-text)">
      <Reveal><SectionHead eyebrow="How it goes" title="Walkthrough, plan, install, establish." /></Reveal>
      <div style="margin-top:var(--space-12)">
        {PROCESS.map(([h, t], i) => (
          <Reveal delay={i * 70}>
            <div style="display:grid;grid-template-columns:auto 1fr;gap:var(--space-8)">
              <div style="display:flex;flex-direction:column;align-items:center">
                <span style="width:10px;height:10px;background:var(--gold-500);flex:0 0 auto;margin-top:8px"></span>
                {i < PROCESS.length - 1 && <span style="width:1px;flex:1;background:var(--border-strong);min-height:40px"></span>}
              </div>
              <div style="padding-bottom:var(--space-10)">
                <h3 style="font:var(--type-h3);margin-bottom:var(--space-3)">{h}</h3>
                <p style="font:var(--type-body);color:var(--text-secondary);max-width:56ch;text-wrap:pretty">{t}</p>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <Reveal><SectionHead eyebrow="Questions about landscape installation" title="What people ask before they hire." /></Reveal>
      <Reveal style={{ marginTop: "var(--space-12)" }}>
        <QuestionList items={[
          { question: "How much does landscape installation cost in Central PA?", answer: "Bed size, how much has to come out first, plant sizes, soil condition and access all move the number. Larger plants cost more but look finished immediately; smaller stock costs less and catches up in two or three seasons.", linkLabel: null, href: null },
          { question: "Can you work with the plants that are already there?", answer: "Usually, and it is worth asking for. A mature specimen that has been in the ground twenty years cannot be bought back at any price. Most renovations keep more than the homeowner expected — the work is taking out what has outgrown the space and rebuilding the beds around what stays.", linkLabel: null, href: null },
          { question: "When is the best time to install landscaping in Pennsylvania?", answer: "Spring and fall both work, and fall is often better — the soil is still warm, the air is cooler, and roots establish before winter without the plant fighting summer heat. Summer installation is possible but needs far more watering.", linkLabel: null, href: null },
          { question: "Do you provide a plan, or do you just plant?", answer: "Worth asking any contractor — a quote for plants is not the same thing as a plan for a yard.", linkLabel: null, href: null },
          { question: "Can landscaping be done as part of a patio project?", answer: "Yes, and it is the better sequence. Beds get cut after the hardscape is set, so the lines follow the finished patio rather than being worked around. The excavation is already open, the machine is already there, and the lawn only gets torn up once.", linkLabel: "Hardscaping", href: "/hardscaping/paver-patios/" },
        ]} />
      </Reveal>
      <Reveal><a href="/resources/faqs/" class="link-underline" style="display:inline-block;margin-top:var(--space-10);font:var(--type-button);letter-spacing:var(--ls-button);text-transform:uppercase;color:var(--green-800);text-decoration:none">See all questions →</a></Reveal>
    </Container>
  </Section>

  <div id="estimate"><EstimateBand title="Send a photo of the front of the house." intro="One picture tells us most of what a planting plan needs — which way it faces, what is there now, how much room there is to work with." /></div>
</Base>

<style>
  @media (min-width: 700px) {
    .li-gallery { grid-template-columns: minmax(0,1.7fr) minmax(0,1fr) !important; }
    .li-cinema-img { aspect-ratio: 21/9 !important; }
    .li-cinema-h { font: var(--type-h1) !important; }
    .li-cinema-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: 0 !important; }
    .li-cinema-grid > div { border-top: none !important; border-left: 1px solid var(--gold-500); padding: 0 clamp(20px,3vw,44px) !important; }
    .li-cinema-grid > div:first-child { border-left: none; padding-left: 0 !important; }
    .li-factors { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .li-factor-offset:nth-child(even) { padding-top: var(--space-10); }
    .li-install-row { grid-template-columns: minmax(0,1fr) minmax(0,.7fr) !important; gap: clamp(24px,4vw,56px) !important; padding: var(--space-6) 0 !important; }
    .li-install-row h3 { font: var(--type-h3) !important; }
    .li-install-row p { font: var(--type-body) !important; }
    .li-install-img-mobile { display: none !important; }
    .li-install-img-wide { display: block !important; }
  }
</style>
