---
/* Ported from ui_kits/website/WalkwaysSteps.jsx. */
import Base from "../../../layouts/Base.astro";
import Container from "../../../components/Container.astro";
import Section from "../../../components/Section.astro";
import Reveal from "../../../components/Reveal.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import SectionHead from "../../../components/SectionHead.astro";
import QuestionList from "../../../components/QuestionList.astro";
import EstimateBand from "../../../components/EstimateBand.astro";
import RelatedProjects from "../../../components/RelatedProjects.astro";

const WK = "/photos/walk/";
const P = "/photos/";
const PHONE = "(717) 736-6538";
const phoneHref = `tel:${PHONE.replace(/\D/g, "")}`;
---
<Base route="walkways-steps" headerOverlay headerActive="Hardscaping">
  <Hero height="min(82vh,740px)" image={WK + "steps-grey.jpg"}
    alt="Grey paver steps with black railings leading up to the side entry of a house"
    eyebrow="Hardscaping · Walkways & steps"
    title="The way to the front door."
    lede="Paver walkway and step installation in New Cumberland, Camp Hill, Mechanicsburg, Harrisburg, Hershey and communities within twenty miles."
    credit="Paver steps and landing">
    <Button slot="primary" variant="solidLight" size="lg" href="#estimate">Request an estimate</Button>
    <Button slot="secondary" variant="inverse" size="lg" href={phoneHref}><Icon name="phone" size={16} />{PHONE}</Button>
  </Hero>

  {/* One transformation */}
  <Section tone="light" tight>
    <Container>
      <div class="wk-transform" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-6) clamp(28px,5vw,72px);align-items:center">
        <Reveal>
          <Eyebrow tone="brand" style={{ marginBottom: "var(--space-4)" }}>Before & after</Eyebrow>
          <h2 style="font:var(--type-h2);letter-spacing:var(--ls-heading);max-width:15ch">A front walk, rebuilt.</h2>
          <dl style="margin:var(--space-6) 0 0">
            <div style="display:grid;grid-template-columns:72px 1fr;gap:var(--space-3);border-top:1px solid var(--gold-500);padding:var(--space-3) 0">
              <dt style="padding-top:2px"><span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-text)">Before</span></dt>
              <dd style="margin:0;font:var(--type-small);color:var(--text-secondary)">The old concrete walk broken out, with the lawn cut back where the new path would run.</dd>
            </div>
            <div style="display:grid;grid-template-columns:72px 1fr;gap:var(--space-3);border-top:1px solid var(--gold-500);padding:var(--space-3) 0">
              <dt style="padding-top:2px"><span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-text)">Built</span></dt>
              <dd style="margin:0;font:var(--type-small);color:var(--text-secondary)">A new paver walkway with a darker border, turning the corner along the front bed.</dd>
            </div>
            <div style="display:grid;grid-template-columns:72px 1fr;gap:var(--space-3);border-top:1px solid var(--gold-500);padding:var(--space-3) 0">
              <dt style="padding-top:2px"><span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-text)">After</span></dt>
              <dd style="margin:0;font:var(--type-small);color:var(--text-secondary)">One continuous path from the street steps toward the house.</dd>
            </div>
          </dl>
        </Reveal>
        <Reveal delay={80}>
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)">
            <figure style="margin:0">
              <img src={WK + "walk2-dig.jpg"} alt="Before: old concrete walk broken out and the ground dug out along the lawn for the new walkway" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;object-position:50% 60%;border-radius:var(--radius-image);display:block" />
              <figcaption style="margin-top:var(--space-2)"><span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-text)">Before</span></figcaption>
            </figure>
            <figure style="margin:0">
              <img src={WK + "walk2-done.jpg"} alt="After: the same walkway finished in pavers with a darker border along the lawn" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;object-position:50% 60%;border-radius:var(--radius-image);display:block" />
              <figcaption style="margin-top:var(--space-2)"><span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-text)">After</span></figcaption>
            </figure>
          </div>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Built from the base up */}
  <Section tone="dark" tight>
    <Container>
      <Reveal>
        <Eyebrow tone="inverse" rule style={{ marginBottom: "var(--space-4)" }}>Built from the base up</Eyebrow>
        <h2 style="font:var(--type-h2);letter-spacing:var(--ls-heading);color:var(--text-on-dark);max-width:16ch">What's under the walk keeps it flat.</h2>
        <p style="font:var(--type-body);color:var(--text-on-dark-secondary);margin-top:var(--space-4);max-width:48ch">A walkway is excavated and built on a compacted stone base before the first paver is set, so it stays level and meets adjoining steps and surfaces cleanly.</p>
      </Reveal>
      <div class="wk-base" style="display:grid;grid-template-columns:minmax(0,1fr);gap:28px;align-items:start;margin-top:var(--space-8)">
        <Reveal>
          <figure style="margin:0">
            <img src={WK + "walk-base-wide2.jpg"} alt="Crew member working the compacted stone base for a walkway beside a raised garden bed, before the pavers are installed" loading="lazy" style="width:100%;height:240px;object-fit:cover;object-position:50% 55%;border-radius:var(--radius-image);display:block" />
            <figcaption style="margin-top:var(--space-3)">
              <span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-300)">The base</span>
              <p style="font:var(--type-caption);color:var(--text-on-dark-secondary);margin-top:4px">Compacted stone prepared before the pavers are installed.</p>
            </figcaption>
          </figure>
        </Reveal>
        <Reveal delay={80}>
          <figure style="margin:0">
            <img src={WK + "walk-steps-after.jpg"} alt="The finished walkway: paver landing and steps along the brick house beside the raised garden bed" loading="lazy" style="width:100%;height:240px;object-fit:cover;object-position:50% 62%;border-radius:var(--radius-image);display:block" />
            <figcaption style="margin-top:var(--space-3)">
              <span style="font:var(--type-eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--gold-300)">The finished walk</span>
              <p style="font:var(--type-caption);color:var(--text-on-dark-secondary);margin-top:4px">Pavers, borders and step transitions complete the surface.</p>
            </figcaption>
          </figure>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Steps */}
  <Section tone="light" tight>
    <Container>
      <div class="wk-steps" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-6) clamp(28px,5vw,72px);align-items:center">
        <Reveal>
          <Eyebrow tone="brand" style={{ marginBottom: "var(--space-4)" }}>Steps</Eyebrow>
          <h2 style="font:var(--type-h2);letter-spacing:var(--ls-heading);max-width:14ch">Where the grade changes.</h2>
          <p style="font:var(--type-body);color:var(--text-secondary);margin-top:var(--space-4);max-width:44ch">Steps carry a walkway up to a door, a deck or a patio. Every step in a run should feel the same underfoot, so the rise and depth are planned before anything is built.</p>
        </Reveal>
        <Reveal delay={80}>
          <div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:var(--space-3);align-items:end">
            <figure style="margin:0">
              <img src={WK + "steps-grey.jpg"} alt="Wide grey paver steps up to a side entry, with black railings" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;object-position:40% 55%;border-radius:var(--radius-image);display:block" />
            </figure>
            <figure style="margin:0">
              <img src={P + "rw/IMG_2719.jpg"} alt="Steps being set into a block wall at the edge of a grey paver patio" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;object-position:60% 45%;border-radius:var(--radius-image);display:block" />
            </figure>
          </div>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Stepping-stone paths */}
  <Section tone="light" tight>
    <Container>
      <div class="wk-stepping" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-6) clamp(28px,5vw,72px);align-items:center">
        <Reveal><img src={WK + "walk-stepping-stones.jpg"} alt="Stepping-stone path of dark square pavers set in white decorative stone, curving from the driveway to the front walk" loading="lazy" style="width:100%;height:230px;object-fit:cover;object-position:50% 60%;border-radius:var(--radius-image);display:block" /></Reveal>
        <Reveal delay={80}>
          <Eyebrow tone="brand" style={{ marginBottom: "var(--space-4)" }}>Stepping-stone paths</Eyebrow>
          <h2 style="font:var(--type-h3);letter-spacing:var(--ls-heading);max-width:20ch">Not every path needs to be paved solid.</h2>
          <p style="font:var(--type-small);color:var(--text-secondary);margin-top:var(--space-3);max-width:42ch">Large pavers set in decorative stone make a lighter path through a bed or along a driveway, held in by a steel or poly edge.</p>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Borders & pattern */}
  <Section tone="sunken" tight>
    <Container>
      <div class="wk-borders" style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-6) clamp(28px,5vw,72px);align-items:center">
        <Reveal>
          <figure style="margin:0">
            <img src={WK + "walk-after.jpg"} alt="Paver walkway with a charcoal border leading to the front of a brick house" loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;object-position:50% 62%;border-radius:var(--radius-image);display:block" />
          </figure>
        </Reveal>
        <Reveal delay={80}>
          <Eyebrow tone="brand" style={{ marginBottom: "var(--space-4)" }}>Borders & pattern</Eyebrow>
          <h2 style="font:var(--type-h3);letter-spacing:var(--ls-heading);max-width:20ch">A border makes a walk look finished.</h2>
          <p style="font:var(--type-small);color:var(--text-secondary);margin-top:var(--space-3);max-width:42ch">A contrasting border frames the field and can match a driveway or patio so the whole front reads as one plan. We install Techo-Bloc and Cambridge pavers.</p>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* More hardscaping */}
  <Section tone="light" tight>
    <Container>
      <Reveal>
        <Eyebrow tone="brand" style={{ marginBottom: "var(--space-4)" }}>More hardscaping</Eyebrow>
        <h2 style="font:var(--type-h3);letter-spacing:var(--ls-heading)">Building more than the walk?</h2>
      </Reveal>
      <ul class="wk-more" style="list-style:none;margin:var(--space-6) 0 0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:0">
        {[["Paver patios", "/hardscaping/paver-patios/"], ["Paver driveways", "/hardscaping/paver-driveways/"], ["Retaining walls", "/hardscaping/retaining-walls/"], ["Fire features & seat walls", "/hardscaping/fire-features/"], ["Grading & drainage", "/hardscaping/drainage/"]].map(([l, h]) => (
          <li style="border-top:1px solid var(--border-strong)">
            <a href={h} style="display:flex;justify-content:space-between;align-items:center;min-height:52px;font:var(--fw-medium) 1rem/1.3 var(--font-sans);color:var(--text-primary);text-decoration:none">
              {l}<span style="color:var(--gold-text)">→</span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="sunken">
    <Container>
      <Reveal><SectionHead eyebrow="Questions about walkways & steps" title="What people ask before they hire." /></Reveal>
      <Reveal style={{ marginTop: "var(--space-8)" }}>
        <QuestionList items={[
          { question: "How much does a paver walkway cost?", answer: "Length and width set most of it. Removing an old walk, steps, a border and how far material has to be carried from the truck move it from there.", linkLabel: null, href: null },
          { question: "Can you replace an old concrete walk or broken steps?", answer: "Yes. The old surface comes out first so the new walk sits on a properly built base.", linkLabel: null, href: null },
          { question: "Can the walkway match my driveway or patio?", answer: "Yes. Using the same paver and border across the walk, driveway and patio makes the front read as one plan. The New Cumberland walk above was built with its parking area.", linkLabel: "Paver driveways", href: "/hardscaping/paver-driveways/" },
          { question: "How long does a walkway take?", answer: "Most of the time goes into removing the old walk and building the base. Unlike poured concrete, there's no cure time before you can walk on it.", linkLabel: null, href: null },
          { question: "What areas do you serve?", answer: "Towns within about twenty miles of New Cumberland, including Camp Hill, Mechanicsburg, Lemoyne, Harrisburg and Hershey.", linkLabel: "Service area", href: "/service-areas/" },
        ]} />
      </Reveal>
    </Container>
  </Section>

  <RelatedProjects service="walkways-steps" />
  <div id="estimate"><EstimateBand title="Send a photo of the walk." intro="A picture of what's there now and where it needs to go tells us more than a paragraph." /></div>
</Base>

<style>
  @media (min-width: 760px) {
    .wk-transform { grid-template-columns: minmax(0,1fr) minmax(0,1.6fr) !important; }
    .wk-base { grid-template-columns: minmax(0,3fr) minmax(0,2fr) !important; gap: clamp(20px,2.4vw,32px) !important; }
    .wk-base img { height: clamp(360px,30vw,420px) !important; }
    .wk-steps { grid-template-columns: minmax(0,1fr) minmax(0,1.5fr) !important; }
    .wk-stepping { grid-template-columns: minmax(0,1.5fr) minmax(0,1fr) !important; }
    .wk-stepping img { height: clamp(320px,28vw,400px) !important; }
    .wk-borders { grid-template-columns: minmax(0,1.4fr) minmax(0,1fr) !important; }
    .wk-more { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: 0 clamp(24px, 4vw, 56px) !important; }
  }
</style>
