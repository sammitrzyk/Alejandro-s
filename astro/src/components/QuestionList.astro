---
import { sx, type StyleObject } from "../lib/style";
interface Item { question: string; answer: string; linkLabel?: string | null; href?: string | null; }
interface Props { items: Item[]; tone?: "light" | "dark"; style?: StyleObject; }
const { items, tone = "light", style } = Astro.props;
const inverse = tone === "dark";
const rule = inverse ? "var(--border-dark)" : "var(--border-hairline)";
const underlineClass = inverse ? "link-underline-dark" : "link-underline";
---
<div style={sx(style)}>
  {items.map((q, i) => (
    <div style={sx({ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(min(100%,300px),1fr))", gap: "var(--space-3) clamp(20px,3.5vw,56px)", alignItems: "start", borderTop: `1px solid ${rule}`, padding: "clamp(20px,2.4vw,28px) 0" })}>
      <div style={sx({ display: "flex", gap: "var(--space-4)" })}>
        <span style={sx({ font: "var(--type-eyebrow)", letterSpacing: "var(--ls-eyebrow)", color: "var(--gold-text)", paddingTop: 5, flex: "0 0 auto", minWidth: 20 })}>{String(i + 1).padStart(2, "0")}</span>
        <h3 style={sx({ font: "var(--fw-regular) clamp(1.125rem,1.45vw,1.3125rem)/1.28 var(--font-display)", letterSpacing: "var(--ls-heading)", color: inverse ? "var(--text-on-dark)" : "var(--text-primary)", maxWidth: "26ch", textWrap: "pretty" })}>{q.question}</h3>
      </div>
      <div>
        <p style={sx({ font: "var(--fw-regular) .9375rem/1.5 var(--font-sans)", color: inverse ? "var(--text-on-dark-secondary)" : "var(--text-secondary)", maxWidth: "60ch", textWrap: "pretty" })}>{q.answer}</p>
        {q.href && (
          <a href={q.href} class={underlineClass} style={sx({ display: "inline-flex", alignItems: "center", gap: "var(--space-2)", marginTop: "var(--space-3)", font: "var(--fw-semibold) .75rem/1 var(--font-sans)", letterSpacing: "var(--ls-button)", textTransform: "uppercase", color: inverse ? "var(--text-on-dark)" : "var(--green-800)", textDecoration: "none" })}>{q.linkLabel} →</a>
        )}
      </div>
    </div>
  ))}
</div>
