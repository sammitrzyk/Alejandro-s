---
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
interface Props { image: string; alt: string; eyebrow: string; title: string; lede: string; credit?: string; height?: string; }
const { image, alt, eyebrow, title, lede, credit, height = "min(92vh,860px)" } = Astro.props;
---
<div style={`position:relative;min-height:${height};display:flex;align-items:flex-end;overflow:hidden;background:var(--green-950)`}>
  <img src={image} alt={alt} fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
  <div style="position:absolute;inset:0;background:var(--scrim-hero)"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,36,22,.55) 0%,rgba(10,36,22,0) 32%)"></div>
  <Container style={{ position: "relative", width: "100%", paddingBottom: "clamp(56px,7vw,104px)", paddingTop: "180px" }}>
    <Eyebrow tone="inverse" rule style={{ marginBottom: "var(--space-8)" }}>{eyebrow}</Eyebrow>
    <h1 style="font:var(--type-display);letter-spacing:var(--ls-display);color:#fff;max-width:15ch;text-wrap:balance;margin-bottom:var(--space-8)">{title}</h1>
    <p style="font:var(--type-lead);color:rgba(255,255,255,.9);max-width:48ch;margin-bottom:var(--space-10);text-wrap:pretty">{lede}</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-4)">
      <slot name="primary" /><slot name="secondary" />
    </div>
  </Container>
  {credit && <span style="position:absolute;right:var(--gutter);bottom:var(--space-6);font:var(--type-caption);color:rgba(255,255,255,.6);text-align:right;max-width:30ch">{credit}</span>}
</div>
