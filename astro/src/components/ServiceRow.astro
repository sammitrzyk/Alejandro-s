---
import { sx, type StyleObject } from "../lib/style";
interface Props { index?: string; title: string; summary: string; points?: string[]; image: string; alt: string; href?: string; flip?: boolean; style?: StyleObject; }
const { index, title, summary, points = [], image, alt, href = "#", flip = false, style } = Astro.props;
---
<div style={sx({ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(320px,1fr))", gap: "clamp(24px,4vw,72px)", alignItems: "center", borderTop: "1px solid var(--border-hairline)", ...style })}>
  {flip && (
    <div class="hover-media" style="position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--stone-200);border-radius:var(--radius-image)">
      <img src={image} alt={alt} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
    </div>
  )}
  <div style="display:flex;flex-direction:column;justify-content:center;gap:var(--space-5);padding:var(--space-10) 0">
    {index && <div style={sx({ font: "var(--type-eyebrow)", letterSpacing: "var(--ls-eyebrow)", color: "var(--gold-text)" })}>{index}</div>}
    <h3 style={sx({ font: "var(--type-h2)", letterSpacing: "var(--ls-heading)", color: "var(--text-primary)", maxWidth: "14ch" })}>{title}</h3>
    <p style={sx({ font: "var(--type-lead)", color: "var(--text-secondary)", maxWidth: "46ch", textWrap: "pretty" })}>{summary}</p>
    {points.length > 0 && (
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-5)">
        {points.map((p) => (
          <li style={sx({ font: "var(--type-small)", color: "var(--text-muted)", display: "flex", alignItems: "center", gap: "var(--space-2)" })}>
            <span style="width:4px;height:4px;background:var(--gold-500);flex:0 0 auto"></span>{p}
          </li>
        ))}
      </ul>
    )}
    <a href={href} class="link-underline" style={sx({ font: "var(--type-button)", letterSpacing: "var(--ls-button)", textTransform: "uppercase", color: "var(--green-800)", textDecoration: "none", alignSelf: "flex-start", marginTop: "var(--space-2)" })}>View {title.toLowerCase()}</a>
  </div>
  {!flip && (
    <div class="hover-media" style="position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--stone-200);border-radius:var(--radius-image)">
      <img src={image} alt={alt} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
    </div>
  )}
</div>
