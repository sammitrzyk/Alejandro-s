---
/* Ported from Shell.jsx's TrustedBy/TrustedCard. The hover "click to view our work" band is
   pure CSS (.trusted-card:hover in global.css); the click target is an anchor to the
   portfolio section instead of a JS scrollTo, so the whole thing needs zero client JS. */
interface Props { href?: string; }
const { href = "#portfolio" } = Astro.props;
const TRUSTED: [string, string, number][] = [
  ["Progressive Dental Concepts", "https://www.progressivedentalconcepts.com/wp-content/uploads/logo-300x148.jpg", 56],
  ["MeadowView Dentistry", "/logos/meadowview-dentistry.png", 96],
  ["Panera Bread", "https://logos-world.net/wp-content/uploads/2022/01/Panera-Bread-Logo.png", 86],
  ["Sauvé Family Dentistry", "/logos/sauve.jpg", 64],
  ["Verizon", "/logos/verizon.png", 40],
  ["Bridge Street Dental Center", "/logos/bridge-street-dental.png", 72],
  ["PMI Property Management, Inc.", "/logos/pmi-property-management.png", 76],
  ["East Main Street Dental", "/logos/east-main-street-dental.png", 84],
  ["Advanced Dental Partners", "/logos/advanced-dental-partners.png", 64],
  ["Linglestown Family Dental", "/logos/linglestown-family-dental.png", 84],
];
---
<section style="background:#F4F5F6;padding:clamp(56px,8vw,112px) 0">
  <div style="max-width:var(--container-max);margin:0 auto;padding:0 var(--gutter)">
    <h2 style="font:var(--fw-medium) clamp(1.125rem,2vw,1.625rem)/1 var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--stone-600);text-align:center;margin-bottom:clamp(32px,5vw,64px)">Trusted by</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:clamp(11px,2.3vw,38px);max-width:1480px;margin:0 auto">
      {TRUSTED.map(([name, src, h]) => (
        <a href={href} class="trusted-card" aria-label={`${name} — view our work`}>
          <span style="position:absolute;left:0;right:0;top:16%;height:68%;display:flex;align-items:center;justify-content:center">
            <img src={src} alt={name} referrerpolicy="no-referrer" style={`height:${(Math.min(1.15, Math.max(0.6, h / 72)) * 100).toFixed(0)}%;max-height:100%;max-width:80%;width:auto;display:block;object-fit:contain`} />
          </span>
          <span class="trusted-band">Click to view our work</span>
        </a>
      ))}
    </div>
  </div>
</section>
