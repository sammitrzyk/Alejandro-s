{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|beforeAlt|afterAlt|caption|ratio|style|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: before, after, beforeAlt, afterAlt, caption, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|inverse|solidLight)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'inverse' | 'solidLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EstimateForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|projects|expectation|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<EstimateForm> doesn't accept that prop. Declared props: tone, projects, expectation, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EstimateForm'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<EstimateForm> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rule|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|accent|inverse)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'brand' | 'accent' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|placeholder|hint|options|rows|required|tone|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, name, type, placeholder, hint, options, rows, required, tone, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|tel|email|textarea|select)$/]",
        "message": "<Field> type must be one of 'text' | 'tel' | 'email' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Field> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileCallBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|estimateHref|onNavigate|hideAbove|revealAfter|style|key|ref|className|style|children)$/]",
        "message": "<MobileCallBar> doesn't accept that prop. Declared props: phone, estimateHref, onNavigate, hideAbove, revealAfter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|town|service|detail|href|ratio|size|style|key|ref|className|style|children)$/]",
        "message": "<ProjectTile> doesn't accept that prop. Declared props: image, alt, town, service, detail, href, ratio, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ProjectTile> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|linkLabel|href|key|ref|className|style|children)$/]",
        "message": "<QuestionItem> doesn't accept that prop. Declared props: question, answer, linkLabel, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|town|service|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<ReviewQuote> doesn't accept that prop. Declared props: quote, name, town, service, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ReviewQuote> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ReviewQuote> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|align|tone|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, title, intro, align, tone, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHead> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHead> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|summary|points|image|alt|href|flip|style|key|ref|className|style|children)$/]",
        "message": "<ServiceRow> doesn't accept that prop. Declared props: index, title, summary, points, image, alt, href, flip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|email|towns|logo|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: phone, email, towns, logo, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|overlay|active|logo|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: phone, overlay, active, logo, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatRowItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<StatRowItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TownEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:town|county|distance|image|alt|notes|href|style|key|ref|className|style|children)$/]",
        "message": "<TownEntry> doesn't accept that prop. Declared props: town, county, distance, image, alt, notes, href, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
